{
  "name": "@sonagi/discord-ui",
  "version": "1.0.0",
  "description": "Sonagi Design System - Discord Bot UI Wrapper",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "dependencies": {
    "@sonagi/tokens": "workspace:*"
  },
  "devDependencies": {
    "discord.js": "^14.15.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
