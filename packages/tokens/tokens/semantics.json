          "warning": {
            "$value": "{primitive.state.warning}",
            "$type": "color",
            "$description": "경고 및 주의 상태"
          },
          "warning-bg": {
            "$value": "{primitive.state.warning-bg}",
            "$type": "color",
            "$description": "경고 상태 요소의 연한 배경"
