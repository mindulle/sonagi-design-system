{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Sonagi Design System",
    "version": "4.0.0",
    "updated": "2026-08-27",
    "description": "Semantic tokens — ADR 0001 (light, amended by ADR 0006 §4) + ADR 0006 (dark). OKLCH hue 24-34 derived. WCAG verified against BOTH bg-base and bg-surface."
  },
  "semantic": {
    "light": {
      "color": {
        "brand": {
          "primary": {
            "$value": "{primitive.burgundy.800}",
            "$type": "color",
            "$description": "Sonagi 브랜드 핵심 컬러 (메인 버튼, 활성화 요소)"
          },
          "primary-hover": {
            "$value": "{primitive.burgundy.900}",
            "$type": "color",
            "$description": "메인 브랜드 컬러의 마우스 호버 상태"
          },
          "accent": {
            "$value": "{primitive.burgundy.400}",
            "$type": "color",
            "$description": "브랜드 보조 강조 컬러 (포인트 요소)"
          },
          "accent-hover": {
            "$value": "{primitive.burgundy.500}",
            "$type": "color",
            "$description": "보조 강조 컬러의 마우스 호버 상태"
          },
          "cyan": {
            "$value": "{primitive.brand.cyan}",
            "$type": "color"
          },
          "ink": {
            "$value": "{primitive.burgundy.800}",
            "$type": "color",
            "$description": "가장 짙은 브랜드 컬러 (브랜드 배경 위에서 강한 대비를 주는 텍스트용)"
          }
        },
        "background": {
          "base": {
            "$value": "{primitive.burgundy.50}",
            "$type": "color",
            "$description": "가장 바닥에 깔리는 도화지 (전체 화면 기본 배경)"
          },
          "surface": {
            "$value": "{primitive.burgundy.100}",
            "$type": "color",
            "$description": "바닥에서 1단계 돌출된 영역 (Input 폼, 카드, 패널 등)"
          },
          "elevated": {
            "$value": "{primitive.burgundy.25}",
            "$type": "color",
            "$description": "가장 높이 떠 있는 2단계 플로팅 영역 (모달 팝업, 툴팁, 드롭다운 메뉴)"
          }
        },
        "text": {
          "primary": {
            "$value": "{primitive.brown.900}",
            "$type": "color",
            "$description": "기본 본문 텍스트 (가장 높은 가독성)"
          },
          "secondary": {
            "$value": "{primitive.brown.600}",
            "$type": "color",
            "$description": "보조 텍스트 (설명, 서브타이틀, 부가 정보)"
          },
          "muted": {
            "$value": "{primitive.brown.500}",
            "$type": "color",
            "$description": "덜 중요한 텍스트 (Placeholder, 힌트, 비활성 느낌)"
          },
          "disabled": {
            "$value": "{primitive.brown.400}",
            "$type": "color",
            "$description": "비활성화(Disabled) 상태의 텍스트 및 아이콘 색상"
          },
          "inverse": {
            "$value": "{primitive.burgundy.50}",
            "$type": "color",
            "$description": "어두운 배경이나 칠해진 브랜드 컬러 위에 올라가는 반전 텍스트"
          }
        },
        "border": {
