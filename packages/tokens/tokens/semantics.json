            "$description": "컴포넌트의 기본 테두리"
          },
          "subtle": {
            "$value": "{primitive.brown.200}",
            "$type": "color",
            "$description": "그림자를 대신하는 아주 얇고 연한 테두리 (구분선 등)"
          },
          "strong": {
            "$value": "{primitive.burgundy.800}",
            "$type": "color",
            "$description": "강조된 테두리 (Hover, Focus 등 상호작용 시)"
